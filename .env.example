# Copy to .env and fill in what you need. .env is gitignored -- never commit
# real credentials or a real TOKEN_DB_URL.
#
# Nothing here is required to start the server if you've already authenticated
# via `garmin-mcp-auth` (see README.md) -- the server reads saved tokens from
# GARMINTOKENS/~/.garminconnect and none of this is needed. These are for the
# credential-login fallback, Docker, HTTP transports, tool filtering, and the
# shared-token backend.

# --- Garmin Connect credentials (optional -- only used as a fallback when no
# --- saved tokens are found; leave unset if you've run `garmin-mcp-auth`) ---
GARMIN_EMAIL=
GARMIN_PASSWORD=
# File-based alternatives (e.g. Docker secrets) -- mutually exclusive with the
# plain vars above; setting both GARMIN_EMAIL and GARMIN_EMAIL_FILE is an error.
# GARMIN_EMAIL_FILE=/run/secrets/garmin_email
# GARMIN_PASSWORD_FILE=/run/secrets/garmin_password

# Use Garmin Connect China (garmin.cn) instead of the international version.
# GARMIN_IS_CN=false

# --- Token storage ------------------------------------------------------
# Directory/file holding saved OAuth tokens. Default: ~/.garminconnect
# GARMINTOKENS=~/.garminconnect
# Base64 token file path, if you use that form. Default: ~/.garminconnect_base64
# GARMINTOKENS_BASE64=~/.garminconnect_base64

# --- Shared-token backend ------------------------------------------------
# This Garmin account may be shared with other services (garmin-scale-sync,
# hevy2garmin-lite, ...). Garmin rotates the refresh token on every refresh,
# so only one is valid fleet-wide at a time -- TOKEN_STORE MUST match whatever
# those other services use, or this service ends up on its own session and
# whichever refreshes second gets locked out. See ai-docs/shared-token-store.md.
#   file      (default) uses GARMINTOKENS / ~/.garminconnect
#   postgres  requires TOKEN_DB_URL below
TOKEN_STORE=file
# TOKEN_DB_URL=postgresql://user:password@host/dbname

# --- MCP transport --------------------------------------------------------
# stdio (default) | streamable-http | sse
# GARMIN_MCP_TRANSPORT=stdio
# Bind address for HTTP transports. Keep 127.0.0.1 unless the endpoint is
# fronted by an authenticating reverse proxy -- there is no built-in auth.
# GARMIN_MCP_HOST=127.0.0.1
# GARMIN_MCP_PORT=8000

# --- Tool filtering ---------------------------------------------------------
# Reduce the tool set exposed to the MCP client. Comma-separated, case-
# insensitive tool names. Unset = all tools register.
#   GARMIN_ENABLED_TOOLS  allowlist -- if set, ONLY these tools register
#   GARMIN_DISABLED_TOOLS denylist -- ignored if an allowlist is set
# GARMIN_ENABLED_TOOLS=get_sleep_data,get_stress_summary,get_activities
# GARMIN_DISABLED_TOOLS=

# --- Activity file downloads ------------------------------------------------
# Default directory for downloaded activity files (download_activity_file).
# When unset, the first call prompts for a directory and persists it to
# GARMIN_FIT_CONFIG.
# GARMIN_FIT_DOWNLOAD_DIR=
# Path to the JSON file that persists the download directory above.
# Default: ~/.garminconnect_fit_config.json
# GARMIN_FIT_CONFIG=
